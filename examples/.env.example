# Aleatoric MCP Examples - Environment Configuration
#
# Copy this file to .env and fill in your actual values
#
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# API Configuration (Required)
# =============================================================================

# Your Aleatoric MCP API key
# Get yours at: https://aleatoric.systems
ALEATORIC_API_KEY=your-api-key-here

# =============================================================================
# Optional Configuration
# =============================================================================

# MCP API Base URL
# Default: https://mcp.aleatoric.systems
# Uncomment to override:
# MCP_BASE_URL=https://mcp.aleatoric.systems

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# =============================================================================
# Demo Configuration
# =============================================================================

# Demo speed multiplier (for demo_script.sh)
# 1.0 = normal speed, 0.5 = faster, 2.0 = slower
# DEMO_SPEED=1.0

# Default output directory for examples
# OUTPUT_DIR=./outputs

# =============================================================================
# Python Configuration
# =============================================================================

# Disable pip version check (speeds up execution)
# PIP_DISABLE_PIP_VERSION_CHECK=1

# Python warnings filter
# Options: default, ignore, always, module, once, error
# PYTHONWARNINGS=default

# =============================================================================
# Advanced Settings
# =============================================================================

# HTTP request timeout (seconds)
# HTTP_TIMEOUT=300

# Maximum concurrent API requests
# MAX_CONCURRENCY=5

# Cache directory for downloaded data
# CACHE_DIR=./cache

{
    "$schema": "https://modelcontextprotocol.io/schema/server.json",
    "mcpVersion": "2024-11-05",
    "server": {
        "name": "aleatoric-engine",
        "version": "0.5.8",
        "description": "Institutional-grade synthetic market data generator and normalizer."
    },
    "keywords": [
        "synthetic data",
        "order book",
        "market data",
        "simulation",
        "quant"
    ],
    "categories": [
        "finance",
        "data",
        "trading"
    ],
    "capabilities": {
        "prompts": {
            "generate_backtest_data": {
                "name": "generate_backtest_data",
                "description": "Generate synthetic market data with specific parameters",
                "arguments": [
                    {
                        "name": "symbol",
                        "description": "The ticker symbol (e.g. BTC)",
                        "required": true
                    },
                    {
                        "name": "duration",
                        "description": "Duration of data to generate (e.g. 1h, 1d)",
                        "required": true
                    }
                ]
            },
            "analyze_funding_costs": {
                "name": "analyze_funding_costs",
                "description": "Simulate funding rates for a specific exchange",
                "arguments": [
                    {
                        "name": "exchange",
                        "description": "Target exchange (binance, hyperliquid, etc.)",
                        "required": true
                    }
                ]
            }
        },
        "tools": {
            "get_health": {
                "description": "Lightweight health check returning server status and timestamp.",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            },
            "validate_config": {
                "description": "Validate a synthetic market configuration JSON object.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "config": {
                            "type": "object",
                            "description": "The SimulationManifest dictionary."
                        }
                    },
                    "required": [
                        "config"
                    ]
                }
            },
            "generate_dataset": {
                "description": "Generate synthetic L2 book and trade events. Each payload includes mark (FDR clean perp price), index (FDR clean spot price), funding_rate_bps (per-tick OU, not static 8h), source_type (depth/trade), and src_latency_ms (simulated source latency in ms). For real-time composite spot+perp streaming, use GET /stream/live with mode=composite_pair.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "symbol": {
                            "type": "string",
                            "description": "Trading symbol (e.g. BTCUSDT)"
                        },
                        "duration_seconds": {
                            "type": "integer",
                            "default": 3600,
                            "description": "Duration in seconds (max 604800). Set >= backtest window to avoid price-path periodicity."
                        },
                        "seed": {
                            "type": "integer",
                            "description": "Random seed for reproducibility"
                        },
                        "tick_size": {
                            "type": "number",
                            "default": 0.01
                        },
                        "lot_size": {
                            "type": "number",
                            "default": 0.001
                        }
                    },
                    "required": [
                        "symbol"
                    ]
                }
            },
            "get_presets": {
                "description": "List available market simulation profiles.",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            },
            "normalize_events": {
                "description": "Normalize raw exchange payloads into canonical Aleatoric format.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "enum": [
                                "synthetic",
                                "hyperliquid",
                                "binance",
                                "cme",
                                "sgx"
                            ]
                        },
                        "events": {
                            "type": "array",
                            "items": {
                                "type": "object"
                            }
                        },
                        "symbol": {
                            "type": "string",
                            "description": "Optional symbol filter"
                        },
                        "stream": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "required": [
                        "source",
                        "events"
                    ]
                }
            },
            "simulate_funding_regime": {
                "description": "Calculate venue-specific funding rates, perp prices, and settlement logic. Returns scalar funding fields plus a `periods` array (one element per settlement interval) containing `period_index`, `start_ts_ms`, `next_funding_time`, `funding_rate`, `funding_rate_bps`, and `premium_bps`. The `num_periods` parameter controls how many forward periods to generate (default 1, max ~12 for a 4-day window). The `seed` parameter makes multi-period generation deterministic.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "exchange": {
                            "type": "string",
                            "enum": [
                                "binance",
                                "hyperliquid",
                                "okx",
                                "bybit",
                                "cme",
                                "sgx"
                            ]
                        },
                        "spot_price": {
                            "type": "number"
                        },
                        "mark_price": {
                            "type": "number"
                        },
                        "position_size": {
                            "type": "number",
                            "description": "Optional position size to calc PnL"
                        },
                        "num_periods": {
                            "type": "integer",
                            "default": 1,
                            "description": "Number of forward funding periods to generate. Default 1 (current period only). Max ~12 (~4-day window for 8h venues)."
                        },
                        "seed": {
                            "type": "integer",
                            "description": "Random seed for deterministic multi-period generation. When omitted, uses a fixed internal default."
                        }
                    },
                    "required": [
                        "exchange",
                        "spot_price",
                        "mark_price"
                    ]
                }
            },
            "get_cache_stats": {
                "description": "Get statistics about the local artifact cache.",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            },
            "get_config_schema": {
                "description": "Get the JSON Schema for SimulationManifest configuration.",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            },
            "get_cache_manifest": {
                "description": "Get provenance metadata for a specific cache entry.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "cache_key": {
                            "type": "string",
                            "description": "The cache key identifier"
                        }
                    },
                    "required": [
                        "cache_key"
                    ]
                }
            },
            "delete_cache": {
                "description": "Delete a specific cache entry by key.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "cache_key": {
                            "type": "string",
                            "description": "The cache key to delete"
                        }
                    },
                    "required": [
                        "cache_key"
                    ]
                }
            },
            "stream_cache": {
                "description": "Stream cached normalized events via SSE.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "cache_key": {
                            "type": "string",
                            "description": "The cache key to stream"
                        }
                    },
                    "required": [
                        "cache_key"
                    ]
                }
            },
            "export_cache": {
                "description": "Export a cached dataset as compressed Parquet.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "cache_key": {
                            "type": "string",
                            "description": "The cache key to export"
                        }
                    },
                    "required": [
                        "cache_key"
                    ]
                }
            },
            "get_venue_details": {
                "description": "Get details about a specific exchange venue adapter.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "exchange": {
                            "type": "string",
                            "enum": [
                                "binance",
                                "hyperliquid",
                                "okx",
                                "bybit",
                                "cme",
                                "sgx"
                            ]
                        }
                    },
                    "required": [
                        "exchange"
                    ]
                }
            }
        },
        "resources": {
            "presets": {
                "uri": "aleatoric://presets",
                "description": "List of all registered simulation presets"
            },
            "cache_stats": {
                "uri": "aleatoric://cache/stats",
                "description": "Statistics about cached datasets"
            },
            "config_schema": {
                "uri": "aleatoric://schema/config",
                "description": "JSON Schema for simulation configuration"
            }
        }
    }
}